# Database (e.g. Supabase, Railway, Neon — any managed Postgres)
DATABASE_URL="postgresql://user:password@host:5432/kyma"

# Better Auth — https://better-auth.com/docs/installation
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-32-plus-char-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_PLUS="price_..."
STRIPE_PRICE_PREMIUM="price_..."

# Video CDN — Bunny Stream (recommended) or swap in Mux/Cloudflare Stream
# in src/components/Player.tsx
NEXT_PUBLIC_BUNNY_CDN_HOSTNAME="your-pullzone.b-cdn.net"
BUNNY_STREAM_LIBRARY_ID=""
BUNNY_STREAM_API_KEY=""
